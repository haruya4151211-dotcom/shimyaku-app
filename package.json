{
  "name": "shimyaku-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "geo": "node geo/build.mjs && node geo/rivers.mjs",
    "check": "node scripts/check.mjs",
    "test:ui": "playwright test",
    "test:ui:desktop": "playwright test --project=desktop",
    "test:ui:mobile": "playwright test --project=mobile",
    "test:ui:viewports": "playwright test --project=mobile-375 --project=mobile-430",
    "test:ui:baseline": "node tests/ui/tools/update-baseline.mjs",
    "test:ui:ux-pending": "UI_UX_PENDING=1 playwright test ux-pending",
    "test:ui:perf": "playwright test -c playwright.perf.config.js",
    "test:ui:install": "playwright install chromium",
    "test:ui:report": "playwright show-report test-results/report"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.61.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "oxlint": "^1.81.0",
    "polygon-clipping": "^0.15.7",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "vite": "^8.3.0"
  }
}
